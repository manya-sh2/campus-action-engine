PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/campus-action-engine
CLIENT_URL=http://localhost:3000

# Required for real Google sign-in (see GOOGLE_SETUP.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=cae_session
SESSION_TTL_DAYS=7
